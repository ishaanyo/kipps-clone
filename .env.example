# AICredits (https://aicredits.in) — LLM + STT + TTS
AICREDITS_API_KEY=sk-your-aicredits-key-here
# AICREDITS_BASE_URL=https://api.aicredits.in/v1

# LiveKit Cloud (Phase 1 continuous call)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxx

# Optional LiveKit model overrides (via AICredits)
# LIVEKIT_LLM_MODEL=gpt-4o-mini
# LIVEKIT_STT_MODEL=whisper-1
# LIVEKIT_TTS_MODEL=tts-1
# LIVEKIT_TTS_VOICE=alloy

LOG_LEVEL=INFO
AGENT_CONFIG_PATH=config/agent_config.yaml

# Hindi / Hinglish friendly (AICredits)
LIVEKIT_STT_MODEL=sarvam/saarika-v2
LIVEKIT_STT_FALLBACK=whisper-1
LIVEKIT_LLM_MODEL=gpt-4o-mini

# TTS – direct AICredits call (real Sarvam speakers work)
# bulbul-v3: priya, ishita, simran, shubh, aditya, anand, ...
# bulbul-v2: anushka, manisha, vidya, arya, abhilash, karun, hitesh
LIVEKIT_TTS_MODEL=sarvam/bulbul-v3
LIVEKIT_TTS_FALLBACK=tts-1
LIVEKIT_TTS_VOICE=priya
