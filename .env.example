# AICredits (https://aicredits.in) — LLM + STT (+ TTS fallback)
AICREDITS_API_KEY=sk-your-aicredits-key-here
# AICREDITS_BASE_URL=https://api.aicredits.in/v1

# Sarvam native API (recommended for TTS — correct speakers)
# Get key at https://dashboard.sarvam.ai
SARVAM_API_KEY=sk_your_sarvam_key_here

# LiveKit Cloud
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=secretxxxxxxxx

LOG_LEVEL=INFO
AGENT_CONFIG_PATH=config/agent_config.yaml

# STT via AICredits (Sarvam Saarika)
LIVEKIT_STT_MODEL=sarvam/saarika-v2
LIVEKIT_STT_FALLBACK=whisper-1
LIVEKIT_LLM_MODEL=gpt-4o-mini

# TTS – native Sarvam when SARVAM_API_KEY is set
# bulbul-v3 speakers: priya, ishita, simran, shubh, aditya, anand, ...
# bulbul-v2 speakers: anushka, manisha, vidya, arya, abhilash, karun, hitesh
LIVEKIT_TTS_MODEL=sarvam/bulbul-v3
LIVEKIT_TTS_FALLBACK=tts-1
LIVEKIT_TTS_VOICE=priya
LIVEKIT_TTS_LANGUAGE=hi-IN
